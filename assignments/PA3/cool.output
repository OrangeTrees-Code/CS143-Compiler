终端机在文法中未使用

    ERROR


语法

    0 $accept: program $end

    1 program: class_list

    2 class_list: class
    3           | class_list class

    4 class: CLASS TYPEID '{' dummy_feature_list '}' ';'
    5      | CLASS TYPEID INHERITS TYPEID '{' dummy_feature_list '}' ';'
    6      | CLASS TYPEID '{' error '}' ';'
    7      | CLASS TYPEID INHERITS TYPEID '{' error '}' ';'
    8      | CLASS error '{' error '}' ';'

    9 dummy_feature_list: ε
   10                   | feature_list

   11 feature_list: feature
   12             | feature_list feature
   13             | feature_list error ';'

   14 feature: OBJECTID '(' formals ')' ':' TYPEID '{' expr '}' ';'
   15        | OBJECTID ':' TYPEID ';'
   16        | OBJECTID ':' TYPEID ASSIGN expr ';'

   17 formals: ε
   18        | formal_list

   19 formal_list: formal
   20            | formal_list ',' formal
   21            | formal_list ',' error

   22 formal: OBJECTID ':' TYPEID

   23 expr: OBJECTID ASSIGN expr
   24     | expr '@' TYPEID '.' OBJECTID '(' actuals ')'
   25     | expr '.' OBJECTID '(' actuals ')'
   26     | OBJECTID '(' actuals ')'
   27     | IF expr THEN expr ELSE expr FI
   28     | WHILE expr LOOP expr POOL
   29     | '{' expr_list '}'
   30     | LET let_bindings IN expr
   31     | CASE expr OF case_list ESAC
   32     | NEW TYPEID
   33     | ISVOID expr
   34     | expr '+' expr
   35     | expr '-' expr
   36     | expr '*' expr
   37     | expr '/' expr
   38     | '~' expr
   39     | expr '<' expr
   40     | expr '=' expr
   41     | expr LE expr
   42     | NOT expr
   43     | '(' expr ')'
   44     | INT_CONST
   45     | STR_CONST
   46     | BOOL_CONST
   47     | OBJECTID

   48 actuals: ε
   49        | expr_list_no_semi

   50 let_bindings: let_binding
   51             | let_bindings ',' let_binding

   52 let_binding: OBJECTID ':' TYPEID
   53            | OBJECTID ':' TYPEID ASSIGN expr
   54            | error

   55 expr_list_no_semi: expr
   56                  | expr_list_no_semi ',' expr

   57 expr_list: expr ';'
   58          | expr_list expr ';'
   59          | expr_list error ';'

   60 case_list: simple_case
   61          | case_list simple_case

   62 simple_case: OBJECTID ':' TYPEID DARROW expr ';'


